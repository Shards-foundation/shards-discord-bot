# Required to connect the bot to Discord. Keep this value local and never commit it.
DISCORD_BOT_TOKEN=

# Optional numeric Discord application snowflake.
DISCORD_APPLICATION_ID=1562965805413568532

# Ollama server reachable FROM the bot process/container.
# Docker Compose uses http://ollama:11434; a bot running on the same host can use http://127.0.0.1:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=120000

# Usage data contains actor/guild IDs, model tags, token counts and duration only.
SHARDS_USAGE_STORE_PATH=.data/usage.json
